        "jsCode": "// LlamaParse devuelve el markdown ya reconstruido, pagina por pagina.\n// Cada pagina se convierte en un item con sus metadatos para poder citar la fuente.\nconst respuesta = $input.first().json;\nconst paginas = respuesta.markdown?.pages ?? [];\n\nif (paginas.length === 0) {\n  throw new Error('LlamaParse no devolvio paginas. Revisar el expand=markdown y el estado del job.');\n}\n\nconst documento = 'DF-MKT-2026.2 - Programa de Marketing Automation y Lead Scoring';\n\nreturn paginas.map((p) => ({\n  json: {\n    texto: p.markdown,\n    pagina: p.page_number,\n    documento,\n    version: '2026.2',\n  },\n}));"
